{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/wardogs_news_tracker.html" },
    { "source": "/api/news", "destination": "/wardogs_news.json" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=300" }
      ]
    }
  ]
}
